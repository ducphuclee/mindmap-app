{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Code Cleaner Triage",
  "type": "object",
  "required": ["generatedAt", "target", "mode", "totalFiles", "fileHashes",
               "exactDuplicates", "similarNameCandidates", "nearCloneCandidates",
               "deadCodeCandidates", "candidateSummary"],
  "properties": {
    "generatedAt": { "type": "string" },
    "target": { "type": "string" },
    "mode": { "type": "string", "enum": ["full", "incremental", "skip"] },
    "skipReason": { "type": ["string", "null"] },
    "totalFiles": { "type": "integer", "minimum": 0 },
    "changedFiles": { "type": "array", "items": { "type": "string" } },
    "fileHashes": { "type": "object", "additionalProperties": { "type": "string" } },
    "exactDuplicates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["hash", "files"],
        "properties": {
          "hash": { "type": "string" },
          "files": { "type": "array", "items": { "type": "string" }, "minItems": 2 }
        },
        "additionalProperties": false
      }
    },
    "similarNameCandidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["normalizedName", "files"],
        "properties": {
          "normalizedName": { "type": "string" },
          "files": { "type": "array", "items": { "type": "string" }, "minItems": 2 }
        },
        "additionalProperties": false
      }
    },
    "nearCloneCandidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["files"],
        "properties": {
          "bucket": { "type": "integer" },
          "files": { "type": "array", "items": { "type": "string" }, "minItems": 2 },
          "lineRange": { "type": "array", "items": { "type": "integer" }, "minItems": 2, "maxItems": 2 }
        },
        "additionalProperties": false
      }
    },
    "deadCodeCandidates": {
      "type": "object",
      "required": ["unusedExports", "unreachableFiles"],
      "properties": {
        "unusedExports": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["file", "symbol", "exportedAt", "importCount"],
            "properties": {
              "file": { "type": "string" },
              "symbol": { "type": "string" },
              "exportedAt": { "type": "integer" },
              "importCount": { "type": "integer" }
            },
            "additionalProperties": false
          }
        },
        "unreachableFiles": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["file", "reason"],
            "properties": {
              "file": { "type": "string" },
              "reason": { "type": "string" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "candidateSummary": {
      "type": "object",
      "required": ["exactDuplicateFiles", "similarNamePairs", "nearClonePairs",
                   "unusedExports", "unreachableFiles"],
      "properties": {
        "exactDuplicateFiles": { "type": "integer" },
        "similarNamePairs": { "type": "integer" },
        "nearClonePairs": { "type": "integer" },
        "unusedExports": { "type": "integer" },
        "unreachableFiles": { "type": "integer" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
