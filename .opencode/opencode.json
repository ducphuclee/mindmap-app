{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "question": "deny"
  },
  "mcp": {
    "venus": {
      "type": "local",
      "enabled": true,
      "command": ["venus", "mcp"],
      "env": {
        "VENUS_PROJECT_PATH": "/Users/phucld/workspace/venus"
      }
    },
    "ripgrep": {
      "type": "local",
      "enabled": true,
      "command": [
        "npx",
        "-y",
        "mcp-ripgrep@latest"
      ]
    },
    "gitnexus": {
      "type": "local",
      "enabled": true,
      "command": [
        "gitnexus",
        "mcp"
      ]
    },
    "sequential-thinking": {
      "type": "local",
      "enabled": true,
      "command": ["npx", "-y", "@modelcontextprotocol/server-sequential-thinking"]
    }
  },
